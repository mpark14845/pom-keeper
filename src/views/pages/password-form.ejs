<%
  const r = record;
  const v = (k) => (r[k] != null ? r[k] : '');
  const linkVal = r.linked_type ? `${r.linked_type}:${r.linked_id}` : '';
%>
<header class="page-header">
  <div>
    <a class="back" href="pom://app<%= returnTo %>"><%- include('../partials/icon', { name: 'back' }) %> <%= returnTo === '/passwords' ? 'Passwords' : 'Back' %></a>
    <h1><%= isNew ? 'New password' : r.title %></h1>
  </div>
</header>
<div class="page-body narrow">
  <form id="password-form" class="card stack" data-id="<%= isNew ? '' : r.id %>" data-return="<%= returnTo %>" novalidate>
    <div class="form-grid">
      <label class="field span-2">
        <span class="field-label">Name <span class="req">*</span></span>
        <input type="text" name="title" value="<%= v('title') %>" maxlength="120" placeholder="e.g. Chase online banking" <%= isNew ? 'autofocus' : '' %> autocomplete="off" spellcheck="false">
        <span class="field-error" data-error-for="title" hidden></span>
      </label>
      <label class="field span-2">
        <span class="field-label">Linked to</span>
        <select name="link">
          <option value="">Nothing</option>
          <% for (const g of linkOptions) { if (!g.items.length) continue; %>
            <optgroup label="<%= g.label %>">
              <% for (const it of g.items) { const val = `${g.type}:${it.id}`; %><option value="<%= val %>" <%= val === linkVal ? 'selected' : '' %>><%= it.name %></option><% } %>
            </optgroup>
          <% } %>
        </select>
        <span class="field-error" data-error-for="link" hidden></span>
      </label>
      <label class="field span-2">
        <span class="field-label">Website</span>
        <input type="text" name="website_url" value="<%= v('website_url') %>" maxlength="300" placeholder="e.g. chase.com" autocomplete="off" spellcheck="false">
      </label>
      <label class="field">
        <span class="field-label">Username</span>
        <input type="text" name="username" class="mono" value="<%= v('username') %>" maxlength="200" autocomplete="off" spellcheck="false">
      </label>
      <label class="field">
        <span class="field-label">Password</span>
        <span class="pw-input">
          <input type="password" name="password" class="mono" value="<%= v('password') %>" maxlength="500" autocomplete="off" spellcheck="false">
          <button type="button" class="btn btn-ghost btn-sm" data-toggle-pw>Show</button>
        </span>
        <button type="button" class="link-btn" data-generate>Generate a strong password</button>
        <span class="field-error" data-error-for="password" hidden></span>
      </label>
      <label class="field">
        <span class="field-label">PIN</span>
        <input type="password" name="pin" class="mono" value="<%= v('pin') %>" maxlength="50" autocomplete="off" inputmode="numeric">
        <span class="field-error" data-error-for="pin" hidden></span>
      </label>
      <label class="field span-2">
        <span class="field-label">Security questions and answers</span>
        <textarea name="security_qa" rows="3" placeholder="Q: First car? A: …"><%= v('security_qa') %></textarea>
      </label>
      <label class="field span-2">
        <span class="field-label">Notes</span>
        <textarea name="notes" rows="3"><%= v('notes') %></textarea>
      </label>
      <label class="check span-2">
        <input type="checkbox" name="include_in_print" <%= r.include_in_print === 0 ? '' : 'checked' %>>
        <span>Include on the printed password sheet</span>
      </label>
    </div>
    <p class="form-error" role="alert" hidden></p>
    <div class="form-actions">
      <% if (!isNew) { %>
        <button type="button" class="btn btn-ghost btn-danger" data-delete><%- include('../partials/icon', { name: 'trash' }) %> Delete</button>
      <% } %>
      <span class="spacer"></span>
      <a class="btn btn-ghost" href="pom://app<%= returnTo %>">Cancel</a>
      <button type="submit" class="btn btn-primary"><%= isNew ? 'Add password' : 'Save changes' %></button>
    </div>
    <div class="confirm" data-confirm hidden>
      <p>Delete this password? This can't be undone.</p>
      <div class="row">
        <button type="button" class="btn btn-danger-solid" data-confirm-yes>Yes, delete</button>
        <button type="button" class="btn btn-ghost" data-confirm-no>Keep it</button>
      </div>
    </div>
  </form>
</div>
