<header class="page-header">
  <div><p class="overline">Logins and PINs</p><h1>Passwords</h1></div>
  <a class="btn btn-primary" href="pom://app/passwords/new"><%- include('../partials/icon', { name: 'plus' }) %> Add password</a>
</header>
<div class="page-body">
  <p class="lede">Website logins, PINs and security answers. Link each one to the account, company or person it belongs to. Passwords stay hidden until you reveal them, and copied passwords are wiped from the clipboard after 30 seconds.</p>
  <% if (!rows.length) { %>
    <div class="card empty">
      <%- include('../partials/icon', { name: 'key' }) %>
      <h2>No passwords yet</h2>
      <p>Add the logins your family would need: online banking, retirement accounts, insurance portals, email.</p>
      <a class="btn btn-primary" href="pom://app/passwords/new">Add the first one</a>
    </div>
  <% } else { %>
    <%- include('../partials/list-search', { placeholder: 'Search passwords…' }) %>
    <div class="card card-flush">
      <table class="table pw-table" data-filterable>
        <thead><tr><th>Name</th><th>Linked to</th><th>Username</th><th>Password</th><th></th></tr></thead>
        <tbody>
        <% for (const r of rows) { %>
          <tr data-href="pom://app/passwords/<%= r.id %>" data-id="<%= r.id %>">
            <td>
              <a class="row-link" href="pom://app/passwords/<%= r.id %>"><%= r.title %></a>
              <% if (r.website_url) { %><div class="meta truncate"><%= r.website_url %></div><% } %>
            </td>
            <td><% if (r.link) { %><span class="meta"><%= r.link.label %>:</span> <%= r.link.name %><% } %></td>
            <td class="mono"><%= r.username || '' %></td>
            <td>
              <% if (r.has_password) { %>
                <span class="secret mono" data-secret>••••••••</span>
              <% } else { %><span class="meta">—</span><% } %>
            </td>
            <td class="actions">
              <% if (r.has_password) { %>
                <button type="button" class="btn btn-ghost btn-sm" data-reveal>Show</button>
                <button type="button" class="btn btn-ghost btn-sm" data-copy-secret="password">Copy</button>
              <% } %>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
      <p class="no-match" hidden>No matches.</p>
    </div>
    <p class="meta toast" data-toast hidden></p>
  <% } %>
</div>
