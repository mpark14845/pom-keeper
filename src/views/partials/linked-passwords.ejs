<section class="card card-flush">
  <div class="card-head">
    <h2>Passwords</h2>
    <a class="btn btn-secondary btn-sm" href="pom://app/passwords/new?link=<%= passwords.link %>&back=<%= passwords.back %>"><%- include('icon', { name: 'plus' }) %> Add password</a>
  </div>
  <% if (!passwords.rows.length) { %>
    <p class="meta card-pad">No saved logins linked here.</p>
  <% } else { %>
    <ul class="plain-list">
      <% for (const c of passwords.rows) { %>
        <li><%- include('icon', { name: 'key' }) %> <a href="pom://app/passwords/<%= c.id %>?back=<%= passwords.back %>"><%= c.title %></a><% if (c.username) { %> <span class="meta">· <%= c.username %></span><% } %></li>
      <% } %>
    </ul>
  <% } %>
</section>
