{
  "name": "pom-keeper",
  "productName": "POM Keeper",
  "version": "0.1.0",
  "description": "Peace Of Mind Keeper: a local, offline, encrypted record of household finances.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/smoke.e2e.js",
    "dist": "electron-builder --win"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "better-sqlite3-multiple-ciphers": "^13.2.0",
    "ejs": "^7.0.2"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.pomkeeper.app",
    "productName": "POM Keeper",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
